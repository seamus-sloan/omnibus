# The Nix `.#web` / `.#e2e` shells provide pnpm (see flake.nix), and that
# copy is authoritative. Disable pnpm's self-version-management so the
# `packageManager` field never triggers a network fetch of a different pnpm
# in CI or the dev shell; the field stays as documentation of the pinned
# version and a hint for corepack users outside Nix.
manage-package-manager-versions=false
