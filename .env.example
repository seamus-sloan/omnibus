# Copy to .env (gitignored) and fill in real values.
#
# Non-secret defaults (DATABASE_URL, PORT, OMNIBUS_PUBLIC_ORIGIN,
# PLAYWRIGHT_BROWSERS_PATH, ANDROID_HOME, …) continue to live in the
# flake.nix shellHook. This file is only for values the shellHook
# shouldn't carry — typically passwords, tokens, or per-developer
# overrides. The shellHook sources .env *after* its own exports, so any
# entry here overrides the matching shellHook default.

# Seeds an admin user on server boot if not already present. Strictly a
# dev convenience — production must NOT set this. Format: username:password.
# Password must be >= 10 chars and not in the common-password list
# (db/src/auth.rs::COMMON_PASSWORDS).
#
# The dev-up script and the ui-validate skill assume this exact value;
# change it only if you understand both will follow you.
OMNIBUS_DEV_SEED_USER=admin:omnibus-dev

# Optional: pre-seed library paths via the `seed_settings_from_env` boot hook,
# which runs on EVERY server boot. When either var is set, the hook overwrites
# the settings row with BOTH values — so setting only one var clears the other
# path, which triggers orphan-library pruning. Set both together (or neither)
# to avoid surprising the operator. Useful for CI, Docker, or dev-up scripting;
# leave unset in production deployments that configure libraries through the UI.
# EBOOK_LIBRARY_PATH=/path/to/ebooks
# AUDIOBOOK_LIBRARY_PATH=/path/to/audiobooks

# F3.3 "Readers also enjoyed" suggestions — account-level Hardcover API token
# (Bearer). Server-wide, never per-user. The Settings page is the source of
# truth; this env var only SEEDS the saved value on first boot when none is set
# (settings wins thereafter), and is the read-time fallback when nothing is
# saved. Leave unset to keep suggestions disabled (the section shows a connect
# message). Read by db::settings::effective_hardcover_api_key.
#
# Also adds Hardcover as the LAST rung of the check-in metadata ladder (it
# authenticates every request, so without a key that rung is skipped entirely).
# It only runs when Open Library and Google Books both came up empty, and its
# own failures are never surfaced — but when it answers it is the one provider
# that carries a book's series natively.
#HARDCOVER_API_KEY=hc_live_xxxxxxxxxxxxxxxx

# ISBN metadata lookup (check-in) — Google Books API key. The lookup ladder
# order is key-dependent: with a key set, Google Books leads and Open Library
# is the fallback; keyless, Open Library leads and Google Books is the fallback.
# Google Books answers WITHOUT a key, but on a shared anonymous daily quota that
# a self-hosted instance hits almost immediately (HTTP 429), so it's only a
# dependable primary once you supply a key of your own.
#
# Free to obtain, no billing account: console.cloud.google.com -> create a
# project -> APIs & Services -> Library -> enable "Books API" -> Credentials ->
# Create credentials -> API key. Restrict it to the Books API; leave the
# application restrictions unset (Omnibus calls Google server-to-server, not
# from a browser). Check your project's Quotas page for the current daily cap.
#
# Same source-of-truth model as the Hardcover key: the Settings page is the
# source of truth; the seed_google_books_key_from_env boot hook seeds this
# value only when none is saved (settings wins thereafter), and
# effective_google_books_api_key falls back to it when settings is empty. It is
# sent as an `X-goog-api-key` header, never in a URL, so no request error can
# render it into the logs.
#GOOGLE_BOOKS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# F4.3 Send-to-Kindle SMTP relay — server-wide, shared with future
# registration / password-reset email. Like the Hardcover key, the Settings
# page is the source of truth; these vars only SEED the saved config on first
# boot when no host is saved (settings wins thereafter) and are the read-time
# fallback. SMTP_HOST + SMTP_FROM_EMAIL are required for the config to be
# considered set; SMTP_PORT defaults to 587 and SMTP_SECURITY to starttls
# (use `tls` for implicit TLS on 465). Leave username/password blank for an
# unauthenticated relay. Read by db::settings::effective_smtp_config.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURITY=starttls
#SMTP_USERNAME=postmaster@example.com
#SMTP_PASSWORD=app-specific-password
#SMTP_FROM_EMAIL=library@example.com

# ── LAN access for the dev server ──────────────────────────────────────────
# `just serve` (and `just serve-pc`) bind dx serve to 0.0.0.0, so other devices
# on your network can reach http://<your-lan-ip>:3000. Two auth guards still
# block a LAN client until you set the two vars below (copy this block into
# .env and fill in your machine's LAN IP — `ipconfig getifaddr en0` on macOS).
#
# TRUSTED NETWORKS ONLY: binding 0.0.0.0 exposes the dev server — auth
# endpoints included — to everything on the LAN. Fine on a home network; do
# NOT run it on public / untrusted Wi-Fi.

# Comma-separated allowlist consumed by auth::origin_check — every cookie-authed
# POST whose Origin isn't listed is rejected with 403. The shellHook defaults
# this to http://localhost:$PORT; override it here to also admit the LAN origin
# you browse from. Keep localhost/127.0.0.1 so local browsing + Playwright still
# work. Override to the proxied origin in production behind a reverse proxy.
#OMNIBUS_PUBLIC_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.42:3000

# Session cookie Secure flag. Defaults to true (cookies sent over HTTPS only).
# Browsers treat http://localhost as a secure context, so the Nix dev shell
# does NOT need this override. Set to 0 only when serving plain http:// from a
# non-localhost origin (e.g. the IP-based LAN dev server above). Never disable
# in production.
#OMNIBUS_SECURE_COOKIES=0

# Filesystem root for cover image files. Defaults to ./covers (relative to the
# server's working directory). Set to an absolute path on production / NAS
# deployments — otherwise covers land next to the binary and disappear on
# redeploy. Read by db::queries::covers_dir.
#OMNIBUS_COVERS_DIR=/var/lib/omnibus/covers

# Filesystem root for the WebP thumbnail cache. Defaults to ./thumbs. Same
# guidance as OMNIBUS_COVERS_DIR — set an absolute path on real deployments.
# Read by db::thumbs::thumbs_dir.
#OMNIBUS_THUMBS_DIR=/var/lib/omnibus/thumbs

# Filesystem root for images embedded in journal entries. Used verbatim when
# set; otherwise defaults to $OMNIBUS_DATA_DIR/journal-images (data dir default
# ./data). Durable user data — NOT a regenerable cache — so back it up with the
# DB and set an absolute path on real deployments (same guidance as
# OMNIBUS_COVERS_DIR). Read by db::journal_images::journal_images_dir.
#OMNIBUS_JOURNAL_IMAGES_DIR=/var/lib/omnibus/journal-images

# Eviction cap for the thumbnail cache, in bytes. Defaults to 1 GiB
# (1073741824) — thumbnails are lossy WebP, so a 1,600-book library caches
# roughly 50 MB across all three sizes. When the cache exceeds this size,
# files are deleted in oldest-mtime-first order; a cache-hit read bumps mtime
# (db::thumbs::touch_thumb), so this is LRU in effect. Read by
# db::thumbs::cap_bytes.
#OMNIBUS_THUMBS_CAP_BYTES=1073741824

# Max accepted size (bytes) for an "add your own books" upload. Enforced
# both as the upload routes' request-body limit and as a per-file check in
# the handler. Defaults to 1 GiB (1073741824). Read by
# server::backend::uploads::max_upload_bytes at router-build time.
#OMNIBUS_MAX_UPLOAD_BYTES=1073741824

# Whether to trust the client-supplied X-Forwarded-For header as the
# per-IP rate-limit key. Defaults to false (the TCP peer IP is used).
#
# WARNING: OMNIBUS_TRUST_FORWARDED_FOR=1 MUST NOT be set unless a trusted
# reverse proxy rewrites X-Forwarded-For before requests reach Axum.
# Setting this on a directly internet-exposed deployment defeats all
# per-IP rate limiting — any client can rotate the header on every
# request to spoof a fresh bucket, trivially bypassing the
# /api/auth/login throttle (10 req/60s) and enabling unbounded
# credential stuffing. Only enable when a known-good proxy (nginx,
# Caddy, Traefik, a cloud load balancer, etc.) sits in front of the
# server and strips inbound X-Forwarded-For from untrusted hops.
# Read by server::rate_limit::trust_forwarded_for.
#OMNIBUS_TRUST_FORWARDED_FOR=1

# ── Admin recovery hook ────────────────────────────────────────────────────
# Promotes the named user to admin on every server boot while the var is set.
# Intended for one-time account recovery only — UNSET IMMEDIATELY AFTER USE.
# Setting this in a production deployment permanently grants admin on every
# restart, which is a serious security risk.
#OMNIBUS_INITIAL_ADMIN=username

# ── HLS transcode cache ────────────────────────────────────────────────────
# Base directory for server data; HLS segments are written under
# $OMNIBUS_DATA_DIR/hls/<book_id>/<profile>/. Defaults to ./data (so the
# HLS cache root is ./data/hls). Set to an absolute path on real
# deployments (same guidance as OMNIBUS_COVERS_DIR).
#OMNIBUS_DATA_DIR=/var/lib/omnibus/data

# Eviction cap for the HLS cache in bytes. Defaults to 5 GiB (5368709120).
#OMNIBUS_HLS_CAP_BYTES=5368709120

# ffmpeg watchdog timeout in seconds per book. Defaults to 1800 (30 min).
# Increase for very long audiobooks on slow hardware.
#OMNIBUS_HLS_TRANSCODE_TIMEOUT_SECS=1800

# Explicit path to the ffmpeg binary. If unset, ffmpeg must be on $PATH.
#OMNIBUS_FFMPEG_PATH=/usr/bin/ffmpeg

# ── Kobo KEPUB conversion ──────────────────────────────────────────────────
# The "Send to Kobo" download converts a book's EPUB to KEPUB via kepubify,
# caching the result at <cache dir>/<book_id>.kepub.epub.
# Explicit path to the kepubify binary; if unset, kepubify must be on $PATH.
# When kepubify is absent the download falls back to plain EPUB (a Kobo reads
# it, just with slower page turns) and logs a one-time startup warning.
#OMNIBUS_KEPUBIFY_PATH=/usr/bin/kepubify

# Directory for the KEPUB cache. Used verbatim when set; otherwise defaults to
# $OMNIBUS_DATA_DIR/kepub (i.e. ./data/kepub). Purely a regenerable cache —
# safe to delete, rebuilt on next download. Set to an absolute path on real
# deployments (same guidance as OMNIBUS_COVERS_DIR / OMNIBUS_THUMBS_DIR).
#OMNIBUS_KEPUB_DIR=/var/lib/omnibus/kepub

# ── Calibre format conversion ──────────────────────────────────────────────
# Explicit path to Calibre's ebook-convert binary; if unset, ebook-convert must
# be on $PATH. Calibre is strictly optional: when the binary can't be resolved
# the server logs one startup warning and leaves format conversion disabled
# rather than failing to boot.
#
# Same source-of-truth model as HARDCOVER_API_KEY: the Settings page wins. The
# seed_ebook_convert_path_from_env boot hook writes this value into the
# `ebook_convert_path` settings row only when none is saved, and an admin can
# override or clear it under Settings → Library Location at any time (clearing
# falls back to this var, then to $PATH).
#
# Unlike kepubify, Calibre is NOT bundled in the Nix dev shells or the release
# image — install it yourself (distro package, `pkgs.calibre`, or the upstream
# installer). A standard install puts ebook-convert on $PATH, so this var is
# only needed when it lives somewhere unusual.
#OMNIBUS_EBOOK_CONVERT_PATH=/usr/bin/ebook-convert

# Format-conversion worker task (#948): Task::ConvertFormat runs ebook-convert
# under a concurrency cap (max(1, num_cpus / 2), mirroring the HLS transcode
# semaphore) and a per-job wall-clock watchdog. ebook-convert is far lighter
# than an ffmpeg transcode, so the default is more modest than
# OMNIBUS_HLS_TRANSCODE_TIMEOUT_SECS's 1800; increase for very large books on
# slow hardware.
#OMNIBUS_CONVERT_TIMEOUT_SECS=600

# Directory for the format-conversion output cache
# (<dir>/<book_id>.<target_format>). Used verbatim when set; otherwise
# defaults to $OMNIBUS_DATA_DIR/convert (i.e. ./data/convert). Purely a
# regenerable cache — safe to delete, rebuilt on next conversion. Set to an
# absolute path on real deployments (same guidance as OMNIBUS_KEPUB_DIR).
#OMNIBUS_CONVERT_DIR=/var/lib/omnibus/convert

# ── Export-with-overrides EPUB cache ───────────────────────────────────────
# When a book has DB metadata/cover overrides, its exports (Send-to-Kobo and
# the plain EPUB download) are served from an override-baked copy of the EPUB
# rather than the untouched source (#1372). That rewritten copy is cached at
# <cache dir>/<book_id>.epub, invalidated on books.last_modified (bumped on
# every override save). Used verbatim when set; otherwise defaults to
# $OMNIBUS_DATA_DIR/export-epub (i.e. ./data/export-epub). Purely a regenerable
# cache — safe to delete, rebuilt on next export. Set to an absolute path on
# real deployments (same guidance as OMNIBUS_KEPUB_DIR).
#OMNIBUS_EXPORT_EPUB_DIR=/var/lib/omnibus/export-epub

# Eviction cap for the export-EPUB cache, in bytes. Defaults to 5 GiB
# (5368709120), same default as OMNIBUS_HLS_CAP_BYTES. Files are deleted in
# oldest-mtime-first order once the cache exceeds this size; unlike the
# thumbnail cache there is no
# cache-hit mtime touch, so eviction is FIFO by last-rewrite time rather
# than true LRU (this cache is written only on an explicit export/download,
# not on every page view). Read by db::epub_rewrite::cap_bytes.
#OMNIBUS_EXPORT_EPUB_CAP_BYTES=5368709120

# ── Release version reporting ───────────────────────────────────────────────
# The running release tag (e.g. v0.8.9), read once at server boot and
# returned as the `version` field on GET /api/_health — the mobile "You"
# screen fetches it there to show alongside the app's own build version
# (#1055). Baked into the Docker image at build time (see Dockerfile,
# .github/workflows/docker.yml); on mobile, testflight.yml stamps the
# equivalent compile-time OMNIBUS_VERSION from the resolved marketing
# version. Leave unset for local dev — the server reports "dev" and the web
# UI falls back to CARGO_PKG_VERSION (0.1.0).
#OMNIBUS_VERSION=v0.8.9

# ── Dev build tooling (sccache) ────────────────────────────────────────────
# In LOCAL dev shells — i.e. when you haven't pinned CARGO_TARGET_DIR or
# RUSTC_WRAPPER yourself — the Nix shell routes rustc through sccache and
# disables incremental compilation (RUSTC_WRAPPER=sccache, CARGO_INCREMENTAL=0,
# SCCACHE_DIR=$HOME/.cache/sccache) so identical crate builds are shared across
# all worktrees, and the per-worktree target/ incremental caches (tens of GB
# each) stop accumulating. CI pins CARGO_TARGET_DIR, so it's unaffected.
#
# Opt out to restore incremental rebuilds — a faster inner loop on the crate
# you're actively editing, at the cost of the target/ bloat sccache avoids.
#OMNIBUS_NO_SCCACHE=1
#
# Resize the shared sccache cache (default 20G). Accepts sccache size suffixes.
#SCCACHE_CACHE_SIZE=20G

# The hot recipes (dev-up, dev-bounce, lint, lint-css, test) run through
# scripts/with-dev-env.sh, which caches `nix print-dev-env` output keyed on
# sha256(flake.nix + flake.lock + shell) so they skip paying the per-invocation
# `nix develop` cost. Set this to bypass the cache and fall back to plain
# `nix develop` for every invocation — e.g. while debugging a stale/poisoned
# cache entry the self-heal check didn't catch.
#OMNIBUS_NO_ENV_CACHE=1

# ── Dev server ─────────────────────────────────────────────────────────────
# Each worktree gets its own 10-port window: the main checkout keeps 3000,
# any other worktree hashes its directory name into 3010..3900. Both
# launchers walk $PORT..$PORT+9 and skip a sibling worktree's server, so two
# worktrees can serve at once. Set PORT to pick a different window base.
#PORT=3000
#
# How long `just dev-up` waits for a freshly-started server to answer
# /api/_health. The default accommodates a cold build in a brand-new
# worktree (the whole workspace into an empty CARGO_TARGET_DIR); it doesn't
# delay a compile error, which is caught when dx exits. Lower it if you'd
# rather fail fast on a warm tree.
#OMNIBUS_DEV_BUILD_TIMEOUT_SECS=900
#
# Bind address for the `just serve` / `just serve-pc` panes. Defaults to
# 0.0.0.0 so LAN devices can reach the dev server — set to 127.0.0.1 to keep
# it loopback-only on an untrusted network.
#OMNIBUS_DEV_ADDR=0.0.0.0

# ── Logging ────────────────────────────────────────────────────────────────
# Console log filter (standard tracing EnvFilter syntax). The server owns its
# tracing subscriber, so this works with `cargo run -p omnibus` and `dx serve`
# alike. Default when unset: info,omnibus=debug — one INFO line per HTTP
# request (method, path, status, latency; query strings never logged).
#RUST_LOG=debug

# Directory for the durable on-disk JSON logs. Alongside the human-readable
# stderr stream, the server writes one JSON record per event to a daily-rolling
# file (omnibus.log.YYYY-MM-DD) via a non-blocking appender. Same RUST_LOG
# filter gates both sinks. Used verbatim when set; otherwise defaults to
# $OMNIBUS_DATA_DIR/logs (i.e. ./data/logs). Set to an absolute path on real
# deployments (same guidance as OMNIBUS_COVERS_DIR / OMNIBUS_DATA_DIR).
#OMNIBUS_LOG_DIR=/var/lib/omnibus/logs
