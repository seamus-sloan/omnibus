# Copy to .env (gitignored) and fill in real values.
#
# Non-secret defaults (DATABASE_URL, PORT, OMNIBUS_PUBLIC_ORIGIN,
# PLAYWRIGHT_BROWSERS_PATH, ANDROID_HOME, …) continue to live in the
# flake.nix shellHook. This file is only for values the shellHook
# shouldn't carry — typically passwords, tokens, or per-developer
# overrides. The shellHook sources .env *after* its own exports, so any
# entry here overrides the matching shellHook default.

# Seeds an admin user on server boot if not already present. Strictly a
# dev convenience — production must NOT set this. Format: username:password.
# Password must be >= 10 chars and not in the common-password list
# (db/src/auth.rs::COMMON_PASSWORDS).
#
# The dev-up script and the ui-validate skill assume this exact value;
# change it only if you understand both will follow you.
OMNIBUS_DEV_SEED_USER=admin:omnibus-dev

# Session cookie Secure flag. Defaults to true (cookies sent over HTTPS only).
# Browsers treat http://localhost as a secure context, so the Nix dev shell
# does NOT need this override. Set to 0 only when serving plain http:// from a
# non-localhost origin (e.g. an IP-based dev server on a LAN). Never disable
# in production.
#OMNIBUS_SECURE_COOKIES=0

# Filesystem root for cover image files. Defaults to ./covers (relative to the
# server's working directory). Set to an absolute path on production / NAS
# deployments — otherwise covers land next to the binary and disappear on
# redeploy. Read by db::queries::covers_dir.
#OMNIBUS_COVERS_DIR=/var/lib/omnibus/covers

# Filesystem root for the WebP thumbnail cache. Defaults to ./thumbs. Same
# guidance as OMNIBUS_COVERS_DIR — set an absolute path on real deployments.
# Read by db::thumbs::thumbs_dir.
#OMNIBUS_THUMBS_DIR=/var/lib/omnibus/thumbs

# Eviction cap for the thumbnail cache, in bytes. Defaults to 5 GiB
# (5368709120). When the cache exceeds this size, files are deleted in
# oldest-mtime-first order (FIFO by mtime — not true LRU, since reads
# don't bump mtime). Read by db::thumbs::cap_bytes.
#OMNIBUS_THUMBS_CAP_BYTES=5368709120
