# Generated by Cargo
# will have compiled files and executables
debug
target
*.db
*.db-shm
*.db-wal

# Dev-server cover cache (F0.1 writes extracted covers to ./covers by default).
# Also ignored under server/ and db/ — `cargo test -p omnibus` / `-p omnibus-db`
# run with CWD=server/ or db/, so cover-writing tests (and init_db's cover-scheme
# sentinel) materialize the cache there.
/covers/
server/covers/
db/covers/
# Dev-server thumbnail WebP cache (F1.2). Same CWD note as covers above —
# init_db writes the encoder-scheme sentinel here on any on-disk database.
/thumbs/
server/thumbs/
db/thumbs/
# F2.3 HLS transcode cache (OMNIBUS_DATA_DIR default = ./data; segments + concat.txt + .progress)
/data/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Node / Playwright
node_modules/
ui_tests/**/test-results/
ui_tests/**/playwright-report/
ui_tests/**/blob-report/
ui_tests/**/.playwright/
# Top-level Playwright `test-results` written when invoked from the repo root.
/test-results/
# Playwright JUnit reports (`junit` reporter) — uploaded to Codecov Test
# Analytics in CI, regenerated every run, never committed.
ui_tests/playwright/results*.xml

# F0.6 cover sidecars materialized next to fixture EPUBs by the indexer.
# The .epub files themselves are committed (regenerated via tools/make_epub.ts);
# the sidecar images are derived cache and must not be committed.
test_data/epubs/**/*.png
test_data/epubs/**/*.jpg
test_data/epubs/**/*.jpeg
test_data/epubs/**/*.webp

# direnv / Nix
.direnv/

# Per-developer env vars (sourced by flake.nix shellHook). The committed
# template is .env.example; .env is gitignored and may contain secrets.
.env

# Runtime scratch for scripts/dev-server-up.sh — server.log, server.pid,
# port, env.sh. Per-checkout, ephemeral.
.claude/runtime/

# Local ebook library (test data)
/epubs
/epubs/

# macOS Finder metadata
.DS_Store
**/.DS_Store
.claude/scheduled_tasks.lock
# Agent worktree scratch directories created by `isolation: worktree` runs.
.claude/worktrees/
sample-library/

# Public-domain test fixtures — large binaries hosted as a GitHub release
# asset (fixtures-vN), fetched by scripts/fetch-fixtures.sh (`just fixtures`).
test_data/epubs/public_domain/
test_data/audiobooks/public_domain/
test_data/.fixtures-version

# Python bytecode (scripts/*.py)
__pycache__/
*.pyc

# Coverage report emitted by `just coverage` (cargo-llvm-cov). Uploaded to
# Codecov in CI; regenerated on every run, never committed.
/lcov.info

# Xcode / Swift (the native iOS app)
# Per-user IDE state — window layout, selected scheme, breakpoints. Xcode
# rewrites these on open and on every build, so tracking them leaves the tree
# dirty after merely opening the project. `xcshareddata/` is the shared
# counterpart and stays committed.
**/xcuserdata/
# Build output. Builds normally land in DerivedData outside the tree, but an
# in-tree copy appears whenever xcodebuild runs without -derivedDataPath.
DerivedData/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
# Swift Package Manager local state (Package.resolved stays committed).
.swiftpm/
.build/
