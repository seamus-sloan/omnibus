layout {
    default_tab_template {
        pane size=2 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="server" focus=true {
        pane command="nix" {
            // dev-serve-fg.sh resolves a free port inside this worktree's
            // window before exec'ing dx serve, so two worktrees running
            // `just serve` at once never collide. It also binds 0.0.0.0 and
            // publishes the chosen port to .claude/runtime/ — see the
            // script for the LAN-exposure caveat.
            args "develop" ".#web" "--command" "scripts/dev-serve-fg.sh"
        }
    }
    tab name="android" {
        pane command="nix" start_suspended=true {
            args "develop" ".#mobile" "--command" "dx" "serve" "--platform" "android" "--package" "omnibus-mobile"
        }
    }
    tab name="ios" {
        // Native SwiftUI app (omnibus-ios/): boot the newest iPhone simulator,
        // build, install, launch. System xcodebuild — no nix shell; `just`
        // comes from the direnv slim shell this session inherits.
        pane command="just" start_suspended=true {
            args "ios-sim"
        }
    }
    tab name="playwright" {
        pane cwd="ui_tests/playwright" command="nix" start_suspended=true {
            args "develop" "../..#e2e" "--command" "npx" "playwright" "test" "--ui"
        }
    }
}
