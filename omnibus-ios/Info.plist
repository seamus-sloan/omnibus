<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Omnibus is self-hosted: the server is whatever machine the reader runs
	     it on, usually plain http on a LAN address, a private hostname, or a
	     box behind a home router. There is no fixed domain to pin an exception
	     to, so ATS has to be off entirely for the app to connect at all.

	     NSAllowsArbitraryLoads must be the ONLY key here. iOS 10 and later
	     *ignore* it whenever NSAllowsLocalNetworking (or the ForMedia /
	     InWebContent variants) is also present, falling back to those narrower
	     keys instead — which silently re-enables ATS for every address that
	     isn't link-local. The symptom is a self-hosted server over http
	     failing with "the resource could not be loaded because the App
	     Transport Security policy requires the use of a secure connection"
	     while a LAN address keeps working. Arbitrary loads already covers
	     local networking, so nothing is lost by dropping the narrower key. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- Whispersync's defining trick is that picking up another device just
		     works — the position moved while the app wasn't running. Without
		     `fetch` the app can only ever sync when someone opens it, so a
		     phone left in a pocket is stale until it's next unlocked. -->
		<string>fetch</string>
	</array>
	<!-- Must list every identifier passed to BGTaskScheduler.register; an
	     unlisted one throws at registration time rather than failing quietly. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.omnibus.sync</string>
	</array>
	<!-- Pre-declare the export-compliance exemption so App Store Connect skips
	     the "Missing Compliance" gate that otherwise blocks every build from
	     TestFlight distribution until it's answered by hand. The app adds no
	     encryption of its own: transport is TLS via the OS, and the only
	     CryptoKit use is SHA-256 over a cache key in RemoteImage, which is a
	     hash rather than encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The three families of the shared design voice — Cormorant Garamond
	     (display), Instrument Sans (UI), Space Mono (numerals and labels) — plus
	     the retired Instrument Serif. The web client pulls them from Google
	     Fonts; iOS has no CDN equivalent, so static cuts are vendored under
	     omnibus/Design/Fonts/ (OFL-1.1, a licence per family alongside them).
	     A name listed here that doesn't resolve fails *silently* — UIFont(name:)
	     returns nil and SwiftUI falls back to the system face — so
	     ThemeFontTests asserts every PostScript name the type scale asks for. -->
	<key>UIAppFonts</key>
	<array>
		<string>CormorantGaramond-Regular.ttf</string>
		<string>CormorantGaramond-Medium.ttf</string>
		<string>CormorantGaramond-SemiBold.ttf</string>
		<string>CormorantGaramond-Italic.ttf</string>
		<string>InstrumentSans-Regular.ttf</string>
		<string>InstrumentSans-Medium.ttf</string>
		<string>InstrumentSans-SemiBold.ttf</string>
		<string>SpaceMono-Regular.ttf</string>
		<string>SpaceMono-Bold.ttf</string>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
	</array>
</dict>
</plist>
