<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget extension runs in its own process with its own sandbox and
	     cannot read this app's container at all, so a shared group is the
	     precondition for every widget rather than an optimisation. The
	     identifier must match `WidgetStore.appGroupID` and the entitlement on
	     OmnibusWidgets exactly: a mismatch is silent — the container URL comes
	     back nil and every widget falls back to its placeholder. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.omnibus.mobile</string>
	</array>
</dict>
</plist>
